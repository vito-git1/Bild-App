{
  "name": "kleiderstudio",
  "private": true,
  "version": "1.0.0",
  "description": "Zwei-Bild-Komposition (Virtual Try-On) über einen n8n-Webhook",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore ./src --ignore ./dist server.ts",
