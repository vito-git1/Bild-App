# Port des Express-Servers
PORT=3000
# Erlaubt Webhook-Ziele in privaten Netzen (z. B. n8n im LAN). Standard: false (SSRF-Schutz aktiv)
ALLOW_PRIVATE_WEBHOOKS=false
# n8n-Webhook, an den der Server die Bilder schickt (bleibt auf dem Server, nie im Browser sichtbar)
WEBHOOK_URL=https://dein-n8n.example.com/webhook/<pfad>
