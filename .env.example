# Port des Express-Servers
PORT=3000
# Erlaubt Webhook-Ziele in privaten Netzen (z. B. n8n im LAN). Standard: false (SSRF-Schutz aktiv)
ALLOW_PRIVATE_WEBHOOKS=false
# n8n-Webhook, an den der Server die Bilder schickt (bleibt auf dem Server, nie im Browser sichtbar)
WEBHOOK_URL=https://dein-n8n.example.com/webhook/<pfad>
# Netzwerk-Schnittstelle. Standard 127.0.0.1 (nur dieser PC). 0.0.0.0 = im ganzen Netzwerk erreichbar
HOST=127.0.0.1
# Optional: Geheimnis, das als Header „X-Kleiderstudio-Secret“ an n8n gesendet wird.
# In n8n im Webhook-Node „Authentication: Header Auth“ mit demselben Namen/Wert einstellen.
WEBHOOK_SECRET=
# Drosselung des Generier-Endpunkts
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT=3
# Cloud-Verlauf in Supabase (nur serverseitig!). Ohne diese Werte ist der Verlauf deaktiviert.
# NIEMALS ins Git-Repo (öffentlich!) und NIEMALS als VITE_* – nur in .env bzw. Vercel Environment Variables.
# Secret Key: Supabase-Dashboard → Project Settings → API Keys → „Secret keys“ (sb_secret_…).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
# Guthaben & Stripe (nur serverseitig, nie als VITE_*). Ohne STRIPE_* gibt es Guthaben, aber keinen Kauf-Knopf.
# Testmodus: sk_test_… aus Stripe → Entwickler → API-Schlüssel; Webhook-Secret (whsec_…) vom Webhook-Endpunkt
# https://<deine-domain>/api/billing/webhook mit Ereignis checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paket: Anzahl Bilder und Preis in Cent (Gratis-Bilder für neue Nutzer = Spalten-Default profiles.credits)
CREDIT_PACK_SIZE=20
CREDIT_PACK_PRICE_CENTS=499
